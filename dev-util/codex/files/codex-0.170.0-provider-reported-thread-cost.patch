 pub(super) fn handle_token_count(chat: &mut ChatWidget, info: Option<TokenUsageInfo>) {
+    handle_token_count_with_cost(chat, info, /*estimated_usage_usd_micros*/ None);
+}
+
+pub(crate) fn handle_token_count_with_cost(
+    chat: &mut ChatWidget,
+    info: Option<TokenUsageInfo>,
+    estimated_usage_usd_micros: Option<i64>,
