+use std::sync::Arc;
+
+use super::*;
+use crate::BearerAuthProvider;
+use codex_api::AuthError;
+use codex_api::AuthHeadersFuture;
+use codex_api::AuthProvider;
+use codex_http_client::OutboundProxyPolicy;
+use pretty_assertions::assert_eq;
+use serde_json::json;
+use wiremock::Mock;
+use wiremock::MockServer;
+use wiremock::ResponseTemplate;
+use wiremock::matchers::header;
+use wiremock::matchers::method;
+use wiremock::matchers::path;
+use wiremock::matchers::query_param;
+
+struct AsyncAuth {
+    fail: bool,
+}
+
+impl AuthProvider for AsyncAuth {
+    fn add_auth_headers(&self, _headers: &mut http::HeaderMap) -> Result<(), AuthError> {
+        Err(AuthError::Build(
+            "asynchronous authentication required".into(),
+        ))
+    }
+
+    fn apply_auth_headers(&self, mut headers: http::HeaderMap) -> AuthHeadersFuture<'_> {
+        Box::pin(async move {
+            if self.fail {
+                return Err(AuthError::Transient("authentication unavailable".into()));
+            }
+            headers.insert(
+                http::header::AUTHORIZATION,
+                http::HeaderValue::from_static("Bearer async-secret"),
+            );
+            Ok(headers)
+        })
+    }
+}
+
+#[tokio::test]
+async fn generation_lookup_uses_async_auth_and_does_not_send_on_auth_failure() {
+    for fail in [false, true] {
+        let server = MockServer::start().await;
+        Mock::given(method("GET"))
+            .and(header("authorization", "Bearer async-secret"))
+            .respond_with(ResponseTemplate::new(200).set_body_json(json!({"total_cost": "0.01"})))
+            .mount(&server)
+            .await;
+        let client = GatewayCostClient::new(
+            server.uri(),
+            Arc::new(AsyncAuth { fail }),
+            HttpClientFactory::new(OutboundProxyPolicy::ReqwestDefault),
+        );
+        assert_eq!(
+            client.generation_cost("generation-1").await,
+            if fail {
+                GatewayGenerationCost::Retry
+            } else {
+                GatewayGenerationCost::Settled(10_000)
+            }
+        );
+        assert_eq!(
+            server
+                .received_requests()
+                .await
+                .expect("received requests")
+                .len(),
+            usize::from(!fail)
+        );
+    }
+}
+
+fn client(server: &MockServer) -> GatewayCostClient {
+    GatewayCostClient::new(
+        format!("{}/codex/v1", server.uri()),
+        Arc::new(BearerAuthProvider::new("gateway-secret".to_string())),
+        HttpClientFactory::new(OutboundProxyPolicy::ReqwestDefault),
+    )
+}
+
+#[test]
+fn detects_gateway_by_normalized_host() {
+    assert!(is_vercel_ai_gateway_base_url(
+        "HTTPS://AI-GATEWAY.VERCEL.SH/codex/v1/"
+    ));
+    assert!(!is_vercel_ai_gateway_base_url(
+        "https://gateway.example.com/v1"
+    ));
+    assert!(!is_vercel_ai_gateway_base_url(
+        "https://ai-gateway.vercel.sh.example.com/v1"
+    ));
+}
+
+#[tokio::test]
+async fn generation_lookup_is_authenticated_normalized_and_parses_settled_cost() {
+    let server = MockServer::start().await;
+    Mock::given(method("GET"))
+        .and(path("/v1/generation"))
+        .and(query_param("id", "generation / 1"))
+        .and(header("authorization", "Bearer gateway-secret"))
+        .respond_with(ResponseTemplate::new(200).set_body_json(json!({
+            "data": [{"total_cost": "0.0043214"}]
+        })))
+        .mount(&server)
+        .await;
+
+    assert_eq!(
+        client(&server).generation_cost("generation / 1").await,
+        GatewayGenerationCost::Settled(4_321)
+    );
+}
+
+#[tokio::test]
+async fn generation_lookup_classifies_retryable_and_terminal_failures() {
+    let retry_server = MockServer::start().await;
+    Mock::given(method("GET"))
+        .respond_with(ResponseTemplate::new(404))
+        .mount(&retry_server)
+        .await;
+    assert_eq!(
+        client(&retry_server).generation_cost("generation-1").await,
+        GatewayGenerationCost::Retry
+    );
+
+    let terminal_server = MockServer::start().await;
+    Mock::given(method("GET"))
+        .respond_with(ResponseTemplate::new(400))
+        .mount(&terminal_server)
+        .await;
+    assert_eq!(
+        client(&terminal_server)
+            .generation_cost("generation-1")
+            .await,
+        GatewayGenerationCost::Unavailable
+    );
+}
+
+#[tokio::test]
+async fn provider_opt_in_overrides_host_detection() {
+    let cost_client = |base_url: &str, vercel_ai_gateway: Option<bool>| {
+        let provider = crate::create_model_provider(
+            codex_model_provider_info::ModelProviderInfo {
+                name: "gateway".to_string(),
+                base_url: Some(base_url.to_string()),
+                experimental_bearer_token: Some("gateway-secret".to_string().into()),
+                vercel_ai_gateway,
+                ..Default::default()
+            },
+            /*auth_manager*/ None,
+        );
+        async move {
+            provider
+                .gateway_cost_client(HttpClientFactory::new(OutboundProxyPolicy::ReqwestDefault))
+                .await
+                .expect("cost client lookup")
+                .is_some()
+        }
+    };
+    let proxy = "http://127.0.0.1:53400/codex/v1";
+    let gateway = "https://ai-gateway.vercel.sh/codex/v1";
+    assert!(!cost_client(proxy, None).await);
+    assert!(cost_client(proxy, Some(true)).await);
+    assert!(cost_client(gateway, None).await);
+    assert!(!cost_client(gateway, Some(false)).await);
+}
