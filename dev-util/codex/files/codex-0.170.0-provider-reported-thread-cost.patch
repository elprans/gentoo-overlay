+#[tokio::test]
+async fn missing_vercel_amount_is_settled_from_generation_endpoint() {
+    let server = MockServer::start().await;
+    Mock::given(method("GET"))
+        .and(path("/v1/generation"))
+        .and(query_param("id", "response-1"))
+        .and(header("authorization", "Bearer gateway-secret"))
+        .respond_with(ResponseTemplate::new(200).set_body_json(serde_json::json!({
+            "data": [{"total_cost": "0.0043214"}]
+        })))
+        .expect(1)
+        .mount(&server)
+        .await;
+
+    let (session, mut turn_context) = make_session_and_context().await;
+    turn_context.provider = Arc::new(TestGatewayProvider {
+        delegate: Arc::clone(&turn_context.provider),
+        cost_client: GatewayCostClient::new(
+            format!("{}/codex/v1", server.uri()),
+            Arc::new(BearerAuthProvider::new("gateway-secret".to_string())),
+            codex_http_client::HttpClientFactory::new(
+                codex_http_client::OutboundProxyPolicy::ReqwestDefault,
+            ),
+        ),
+    });
+    let session = Arc::new(session);
+    let turn_context = Arc::new(turn_context);
+
+    let reconciliation = session
+        .record_response_cost(&turn_context, "response-1", /*usage_metadata*/ None)
+        .await
+        .expect("missing Vercel amount should start reconciliation");
+    assert_eq!(
+        session.state.lock().await.thread_cost_info(),
+        Some(ThreadCostInfo {
+            total_cost_usd_micros: 0,
+            is_complete: false,
+            incremental_cost_usd_micros: Some(0),
+            is_incremental_cost_complete: Some(false),
+        })
+    );
+
+    session.spawn_gateway_cost_reconciliation(Arc::clone(&turn_context), reconciliation);
+    tokio::time::timeout(Duration::from_secs(2), async {
+        loop {
+            let cost = session.state.lock().await.thread_cost_info();
+            if cost.is_some_and(|cost| cost.is_complete) {
+                break;
+            }
+            tokio::task::yield_now().await;
+        }
+    })
+    .await
+    .expect("generation cost should settle");
+
+    assert_eq!(
+        session.state.lock().await.thread_cost_info(),
+        Some(ThreadCostInfo {
+            total_cost_usd_micros: 4_321,
+            is_complete: true,
+            incremental_cost_usd_micros: Some(4_321),
+            is_incremental_cost_complete: Some(true),
+        })
+    );
+}
