+#[tokio::test]
+async fn shipped_cli_ignores_existing_managed_release() {
+    let temp = tempfile::TempDir::new().expect("temp");
+    let home = temp.path().join("home");
+    let managed = package(
+        &home.join("packages/app-server-daemon/releases/0.159.1-aarch64-apple-darwin"),
+        "0.159.1",
+    );
+    std::os::unix::fs::symlink(
+        managed.parent().expect("bin").parent().expect("release"),
+        home.join("packages/app-server-daemon/current"),
+    )
+    .expect("managed selection");
+    let shipped = temp.path().join("port/bin/codex");
+    std::fs::create_dir_all(shipped.parent().expect("bin")).expect("shipped directory");
+    std::fs::write(&shipped, b"shipped codex").expect("shipped binary");
+    let mut daemon = daemon(&home);
+    daemon.managed_codex_bin = shipped.clone();
+    daemon.shipped_codex_bin = Some(shipped.clone());
+
+    let selected = daemon.current_installation().expect("installation");
+    assert_eq!(selected.managed_codex_bin, shipped);
+    prepare(&selected, &DaemonSettings::default())
+        .await
+        .expect("shipped CLI needs no managed copy");
+    assert_eq!(
+        std::fs::read_to_string(home.join("packages/app-server-daemon/current/bin/codex"))
+            .expect("managed release"),
+        "#!/bin/sh\necho 'codex 0.159.1'\n"
+    );
+}
