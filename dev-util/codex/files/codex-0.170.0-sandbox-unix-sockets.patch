+#[test]
+fn managed_local_binding_supports_buffered_sendfile_fallback() {
+    const HELPER_ENV: &str = "CODEX_TEST_SENDFILE_FALLBACK";
+    const SOURCE_ENV: &str = "CODEX_TEST_SENDFILE_SOURCE";
+    const TARGET_ENV: &str = "CODEX_TEST_SENDFILE_TARGET";
+    const BYTE_COUNT: usize = 8_193;
+
+    if std::env::var_os(HELPER_ENV).is_some() {
+        let source_path = std::env::var_os(SOURCE_ENV).expect("source path");
+        let source = std::fs::File::open(&source_path).expect("open source");
+        let mut stream = TcpStream::connect(std::env::var(TARGET_ENV).expect("target address"))
+            .expect("connect to loopback listener");
+        let mut transferred = BYTE_COUNT as libc::off_t;
+        let result = unsafe {
+            libc::sendfile(
+                source.as_raw_fd(),
+                stream.as_raw_fd(),
+                0,
+                &mut transferred,
+                std::ptr::null_mut(),
+                0,
+            )
+        };
+        assert_eq!(result, -1, "destination-scoped policy must reject sendfile");
+        let error = std::io::Error::last_os_error();
+        assert!(matches!(
+            error.raw_os_error(),
+            Some(libc::EPERM | libc::EACCES)
+        ));
+        let payload = std::fs::read(source_path).expect("read fallback payload");
+        stream
+            .write_all(&payload)
+            .expect("buffered loopback transfer");
+        return;
+    }
+
+    let workspace = tempfile::tempdir().expect("temporary workspace");
+    let source_path = workspace.path().join("source.bin");
+    let expected = (0..BYTE_COUNT)
+        .map(|index| (index % 251) as u8)
+        .collect::<Vec<_>>();
+    std::fs::write(&source_path, &expected).expect("write source");
+    let listener = TcpListener::bind("127.0.0.1:0").expect("loopback listener");
+    let address = listener.local_addr().expect("listener address");
+    let managed_network = ManagedNetworkSandboxContext {
+        loopback_ports: vec![address.port()],
+        allow_local_binding: true,
+        ..Default::default()
+    };
+    let module = module_path!().split_once("::").expect("test module path").1;
+    let args = create_seatbelt_command_args(CreateSeatbeltCommandArgsParams {
+        command: vec![
+            std::env::current_exe()
+                .expect("test executable")
+                .to_string_lossy()
+                .into_owned(),
+            "--exact".into(),
+            format!("{module}::managed_local_binding_supports_buffered_sendfile_fallback"),
+            "--nocapture".into(),
+        ],
+        file_system_sandbox_policy: &FileSystemSandboxPolicy::read_only(),
+        network_sandbox_policy: NetworkSandboxPolicy::Enabled,
+        sandbox_policy_cwd: workspace.path(),
+        enforce_managed_network: true,
+        managed_network: Some(&managed_network),
+        environment_id: None,
+        network: None,
+        extra_allow_unix_sockets: &[],
+    })
+    .expect("generated Seatbelt arguments");
+    let output = Command::new(MACOS_PATH_TO_SEATBELT_EXECUTABLE)
+        .args(args)
+        .env(HELPER_ENV, "1")
+        .env(SOURCE_ENV, &source_path)
+        .env(TARGET_ENV, address.to_string())
+        .output()
+        .expect("run buffered transfer probe");
+    let stderr = String::from_utf8_lossy(&output.stderr);
+    if !output.status.success()
+        && stderr.contains("sandbox-exec: sandbox_apply: Operation not permitted")
+    {
+        eprintln!("skipping buffered transfer regression: nested Seatbelt unavailable");
+        return;
+    }
+    assert!(output.status.success(), "{output:?}");
+    let (mut stream, _) = listener.accept().expect("accept buffered transfer");
+    stream
+        .set_read_timeout(Some(Duration::from_secs(2)))
+        .expect("read timeout");
+    let mut received = Vec::new();
+    stream
+        .read_to_end(&mut received)
+        .expect("receive buffered payload");
+    assert_eq!(received, expected);
+}
