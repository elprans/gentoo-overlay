+//! Filesystem compression of a fresh output before it is shared.
+//!
+//! The store ingests compiler outputs as reflinks of the files the compiler
+//! wrote, so a compressed store directory alone never compresses them: Btrfs
+//! decides compression when data is written, and a reflink only adds a
+//! reference to existing extents. Rewriting the output compressed *before* it
+//! is shared makes the build tree and the store share compressed extents.
+//!
+//! Only a file that shares no extents is rewritten. Rewriting a shared extent
+//! would give this file a private compressed copy and keep the shared one,
+//! using more disk, not less.
+
+use std::io;
+use std::path::Path;
+
+/// A compression algorithm the filesystem applies to rewritten data.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum CompressionAlgorithm {
+    Zlib,
+    Lzo,
+    Zstd,
+}
+
+/// The algorithm and optional level for [`compress_in_place`]. `None` takes
+/// the filesystem's default level for the algorithm.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct Compression {
+    pub algorithm: CompressionAlgorithm,
+    pub level: Option<i8>,
+}
+
+/// What [`compress_in_place`] did with a file.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum CompressOutcome {
+    /// The file's data was rewritten through the filesystem's compression.
+    Compressed,
+    /// Smaller than [`MIN_COMPRESS_BYTES`]; Btrfs stores such files inline.
+    TooSmall,
+    /// Some extents are shared with another file and were left alone.
+    Shared,
+    /// Not a regular file, or the filesystem cannot compress in place.
+    Unsupported,
+}
+
+/// Files below this size are left alone: Btrfs keeps small files inline in
+/// metadata, where its own compression already applies.
+pub const MIN_COMPRESS_BYTES: u64 = 4096;
+
+/// Rewrite `path`'s data through the filesystem's compression, if it is a
+/// regular file on Btrfs that shares no extents.
+///
+/// The data is flushed first: Btrfs does not recompress data that is still
+/// waiting for writeback. The rewrite is started before returning, and a
+/// later reflink of the file waits for it, so the clone shares the
+/// compressed extents.
+pub fn compress_in_place(path: &Path, compression: Compression) -> io::Result<CompressOutcome> {
+    #[cfg(target_os = "linux")]
+    {
+        crate::linux::compress_in_place(path, compression)
+    }
+    #[cfg(not(target_os = "linux"))]
+    {
+        let _ = (path, compression);
+        Ok(CompressOutcome::Unsupported)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const ZSTD: Compression = Compression {
+        algorithm: CompressionAlgorithm::Zstd,
+        level: Some(3),
+    };
+
+    #[test]
+    fn small_files_and_directories_are_left_alone() {
+        let dir = tempfile::tempdir().unwrap();
+        let small = dir.path().join("small");
+        std::fs::write(&small, b"tiny").unwrap();
+        assert_eq!(
+            compress_in_place(&small, ZSTD).unwrap(),
+            CompressOutcome::TooSmall
+        );
+        assert_eq!(
+            compress_in_place(dir.path(), ZSTD).unwrap(),
+            CompressOutcome::Unsupported
+        );
+    }
+
+    /// On Btrfs a fresh file is compressed and a reflink of it is then left
+    /// alone; elsewhere the call reports that it cannot compress.
+    #[test]
+    fn fresh_files_compress_and_shared_files_do_not() {
+        let dir = tempfile::tempdir_in(
+            std::env::var_os("KACHE_TEST_BTRFS_DIR").unwrap_or_else(|| std::env::temp_dir().into()),
+        )
+        .unwrap();
+        let fresh = dir.path().join("fresh");
+        std::fs::write(&fresh, vec![b'k'; 1 << 20]).unwrap();
+        let outcome = compress_in_place(&fresh, ZSTD).unwrap();
+        if outcome == CompressOutcome::Unsupported {
+            eprintln!("skipping: {} is not on Btrfs", dir.path().display());
+            return;
+        }
+        assert_eq!(outcome, CompressOutcome::Compressed);
+        assert_eq!(std::fs::read(&fresh).unwrap(), vec![b'k'; 1 << 20]);
+
+        let clone = dir.path().join("clone");
+        crate::copy::try_reflink(&fresh, &clone).unwrap();
+        assert_eq!(
+            compress_in_place(&fresh, ZSTD).unwrap(),
+            CompressOutcome::Shared
+        );
+        assert_eq!(std::fs::read(&clone).unwrap(), vec![b'k'; 1 << 20]);
+    }
+}
