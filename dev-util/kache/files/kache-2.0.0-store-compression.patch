+/// Filesystem compression algorithm for outputs entering the store.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum StoreCompressionAlgorithm {
+    Zlib,
+    Lzo,
+    Zstd,
+}
+
+/// Btrfs's default zstd level, which a directory's `compression=zstd`
+/// property also uses.
+pub const DEFAULT_ZSTD_LEVEL: i8 = 3;
+
+/// Compression applied to an output before the store shares its extents.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct StoreCompression {
+    pub algorithm: StoreCompressionAlgorithm,
+    /// `None` only for lzo, which has no levels.
+    pub level: Option<i8>,
+}
+
+impl StoreCompression {
+    /// Parse an algorithm name and optional level, applying the algorithm's
+    /// default level. `off`/`none`/empty disables compression (`Ok(None)`).
+    pub fn parse(algorithm: &str, level: Option<i64>) -> Result<Option<Self>, String> {
+        let algorithm = match algorithm.trim().to_ascii_lowercase().as_str() {
+            "" | "off" | "none" | "false" | "0" => return Ok(None),
+            "zstd" => StoreCompressionAlgorithm::Zstd,
+            "zlib" => StoreCompressionAlgorithm::Zlib,
+            "lzo" => StoreCompressionAlgorithm::Lzo,
+            other => {
+                return Err(format!(
+                    "unknown store compression {other:?}; expected zstd, zlib, lzo, or off"
+                ));
+            }
+        };
+        let (range, default) = match algorithm {
+            StoreCompressionAlgorithm::Zstd => (-15..=15, Some(DEFAULT_ZSTD_LEVEL)),
+            StoreCompressionAlgorithm::Zlib => (1..=9, Some(3)),
+            StoreCompressionAlgorithm::Lzo => {
+                if level.is_some() {
+                    return Err("lzo store compression has no levels".to_string());
+                }
+                return Ok(Some(Self {
+                    algorithm,
+                    level: None,
+                }));
+            }
+        };
+        let level = match level {
+            None => default,
+            Some(0) => default,
+            Some(level) if range.contains(&level) => Some(level as i8),
+            Some(level) => {
+                return Err(format!(
+                    "store compression level {level} is outside {}..={}",
+                    range.start(),
+                    range.end()
+                ));
+            }
+        };
+        Ok(Some(Self { algorithm, level }))
+    }
+}
