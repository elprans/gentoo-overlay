+const BTRFS_SUPER_MAGIC: libc::c_long = 0x9123_683e;
+/// `_IOW(BTRFS_IOCTL_MAGIC, 16, struct btrfs_ioctl_defrag_range_args)`.
+const BTRFS_IOC_DEFRAG_RANGE: libc::c_ulong = 0x4030_9410;
+const BTRFS_DEFRAG_RANGE_COMPRESS: u64 = 1;
+const BTRFS_DEFRAG_RANGE_START_IO: u64 = 2;
+const BTRFS_DEFRAG_RANGE_COMPRESS_LEVEL: u64 = 4;
+
+/// `struct btrfs_ioctl_defrag_range_args` with the `compress` union member
+/// that carries a level (Linux 6.15 and later).
+#[repr(C)]
+struct DefragRangeArgs {
+    start: u64,
+    len: u64,
+    flags: u64,
+    extent_thresh: u32,
+    compress_type: u8,
+    compress_level: i8,
+    _pad: u16,
+    _unused: [u32; 4],
+}
+
+const _: () = assert!(std::mem::size_of::<DefragRangeArgs>() == 48);
+
+fn btrfs_compress_type(algorithm: crate::CompressionAlgorithm) -> u8 {
+    match algorithm {
+        crate::CompressionAlgorithm::Zlib => 1,
+        crate::CompressionAlgorithm::Lzo => 2,
+        crate::CompressionAlgorithm::Zstd => 3,
+    }
+}
+
+fn defrag_compress(file: &File, compression: crate::Compression) -> io::Result<()> {
+    let mut flags = BTRFS_DEFRAG_RANGE_COMPRESS | BTRFS_DEFRAG_RANGE_START_IO;
+    if compression.level.is_some() {
+        flags |= BTRFS_DEFRAG_RANGE_COMPRESS_LEVEL;
+    }
+    let args = DefragRangeArgs {
+        start: 0,
+        len: u64::MAX,
+        flags,
+        // Rewrite every extent, however large: the point is to compress.
+        extent_thresh: 1,
+        compress_type: btrfs_compress_type(compression.algorithm),
+        compress_level: compression.level.unwrap_or(0),
+        _pad: 0,
+        _unused: [0; 4],
+    };
+    // SAFETY: `args` matches the kernel's 48-byte argument struct and lives
+    // for the duration of the call; the kernel only reads it.
+    let rc = unsafe {
+        libc::ioctl(
+            file.as_raw_fd(),
+            BTRFS_IOC_DEFRAG_RANGE as _,
+            &raw const args,
+        )
+    };
+    if rc == 0 {
+        Ok(())
+    } else {
+        Err(io::Error::last_os_error())
+    }
+}
+
+fn is_btrfs(file: &File) -> io::Result<bool> {
+    let mut stats = std::mem::MaybeUninit::<libc::statfs>::uninit();
+    // SAFETY: `fstatfs` fills the provided buffer on success.
+    let rc = unsafe { libc::fstatfs(file.as_raw_fd(), stats.as_mut_ptr()) };
+    if rc != 0 {
+        return Err(io::Error::last_os_error());
+    }
+    // SAFETY: initialized by the successful call above.
+    let stats = unsafe { stats.assume_init() };
+    Ok(stats.f_type as libc::c_long == BTRFS_SUPER_MAGIC)
+}
+
+pub(crate) fn compress_in_place(
+    path: &Path,
+    compression: crate::Compression,
+) -> io::Result<crate::CompressOutcome> {
+    let metadata = std::fs::symlink_metadata(path)?;
+    if !metadata.file_type().is_file() {
+        return Ok(crate::CompressOutcome::Unsupported);
+    }
+    if metadata.len() < crate::MIN_COMPRESS_BYTES {
+        return Ok(crate::CompressOutcome::TooSmall);
+    }
+    // Defragmentation needs a writable descriptor; it does not change content.
+    let file = OpenOptions::new()
+        .read(true)
+        .write(true)
+        .custom_flags(libc::O_NOFOLLOW | libc::O_CLOEXEC)
+        .open(path)?;
+    if !is_btrfs(&file)? {
+        return Ok(crate::CompressOutcome::Unsupported);
+    }
+    // Btrfs skips ranges still waiting for writeback, so flush them first.
+    file.sync_data()?;
+    // An unknown extent state counts as shared: leave the file alone.
+    match fiemap(&file)?.map(|accounting| accounting.sharing()) {
+        Some(crate::Sharing::None) => {}
+        _ => return Ok(crate::CompressOutcome::Shared),
+    }
+    match defrag_compress(&file, compression) {
+        // Kernels before 6.15 reject the level flag; use the default level.
+        Err(error)
+            if compression.level.is_some()
+                && matches!(error.raw_os_error(), Some(libc::EOPNOTSUPP | libc::EINVAL)) =>
+        {
+            defrag_compress(
+                &file,
+                crate::Compression {
+                    level: None,
+                    ..compression
+                },
+            )?;
+        }
+        result => result?,
+    }
+    Ok(crate::CompressOutcome::Compressed)
+}
