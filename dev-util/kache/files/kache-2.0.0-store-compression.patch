+/// Rewrite a fresh output through Btrfs compression before the store
+/// reflinks it, so the build tree and the store share compressed extents.
+/// Best-effort: an output that cannot be compressed is stored as it is.
+fn compress_output_for_store(
+    source: &Path,
+    compression: kache_core::store_config::StoreCompression,
+) {
+    use kache_core::store_config::StoreCompressionAlgorithm as Algorithm;
+    let compression = kache_fs::Compression {
+        algorithm: match compression.algorithm {
+            Algorithm::Zstd => kache_fs::CompressionAlgorithm::Zstd,
+            Algorithm::Zlib => kache_fs::CompressionAlgorithm::Zlib,
+            Algorithm::Lzo => kache_fs::CompressionAlgorithm::Lzo,
+        },
+        level: compression.level,
+    };
+    match kache_fs::compress_in_place(source, compression) {
+        Ok(outcome) => {
+            tracing::trace!(path = %source.display(), ?outcome, "store compression");
+        }
+        Err(error) => {
+            tracing::debug!(
+                path = %source.display(),
+                %error,
+                "store compression failed; storing the output uncompressed"
+            );
+        }
+    }
+}
