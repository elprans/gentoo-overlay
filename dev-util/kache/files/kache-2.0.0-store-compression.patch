+fn store_compression_is_off_unless_configured_and_env_wins() {
+    use kache_core::store_config::{StoreCompression, StoreCompressionAlgorithm};
+    let _lock = config_path_lock();
+    let zstd = |level| {
+        Some(StoreCompression {
+            algorithm: StoreCompressionAlgorithm::Zstd,
+            level: Some(level),
+        })
+    };
+    let resolve = |file: &str| {
+        let file: Result<FileConfig> = Ok(toml::from_str(file).unwrap());
+        Config::store_compression_for(&InvocationEnv::capture(), &file)
+    };
+    // SAFETY: the process-state lock serialises environment edits.
+    unsafe {
+        std::env::remove_var("KACHE_STORE_COMPRESSION");
+        std::env::remove_var("KACHE_STORE_COMPRESSION_LEVEL");
+    }
+    assert_eq!(resolve("").unwrap(), None);
+    assert_eq!(
+        resolve("[cache]\nstore_compression_level = 9\n").unwrap(),
+        None
+    );
+    assert_eq!(
+        resolve("[cache]\nstore_compression = \"zstd\"\n").unwrap(),
+        zstd(3)
+    );
+    let leveled = "[cache]\nstore_compression = \"zstd\"\nstore_compression_level = 7\n";
+    assert_eq!(resolve(leveled).unwrap(), zstd(7));
+    assert!(
+        resolve("[cache]\nstore_compression = \"zstd\"\nstore_compression_level = 99\n").is_err()
+    );
+
+    unsafe { std::env::set_var("KACHE_STORE_COMPRESSION_LEVEL", "1") };
+    assert_eq!(resolve(leveled).unwrap(), zstd(1), "the env level wins");
+    unsafe { std::env::set_var("KACHE_STORE_COMPRESSION_LEVEL", "high") };
+    assert!(resolve(leveled).is_err());
+    unsafe {
+        std::env::remove_var("KACHE_STORE_COMPRESSION_LEVEL");
+        std::env::set_var("KACHE_STORE_COMPRESSION", "off");
+    }
+    assert_eq!(resolve(leveled).unwrap(), None, "the env switch wins");
+    unsafe { std::env::remove_var("KACHE_STORE_COMPRESSION") };
+}
